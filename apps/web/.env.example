# --- Supabase (REQUIRED) ----------------------------------------------------
# Project URL + anon key from Supabase dashboard → Project Settings → API.
# Service-role key is server-only — never expose it to the client.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic (optional — Phase 3 document intake) -------------------------
# Needed only for the Claude Vision proforma parser at /transactions/new.
# Set a $5 spend cap on console.anthropic.com → Settings → Limits.
ANTHROPIC_API_KEY=

# --- SOR Python service (Phase 4) -------------------------------------------
# Defaults to local uvicorn. Point at your Modal deploy in production.
SOR_SERVICE_URL=http://localhost:8000

# --- Chaîne (registre de confirmation, escrow, eERC) -------------------------
# Cible : L1 Avalanche dédiée « pir » (Subnet-EVM) sur le réseau local avalanche-cli.
# Voir docs/avalanche-l1.md. Bascule vers Fuji C-Chain (repli) = changer ces 3 lignes.
#   L1 locale  : RPC affiché par `infra/avalanche/l1-local.sh rpc`, chainId 7810, pas d'explorer
#   Fuji C-Chain: https://api.avax-test.network/ext/bc/C/rpc, chainId 43113, https://testnet.snowtrace.io
CHAIN_RPC_URL=http://127.0.0.1:9654/ext/bc/<blockchainID>/rpc
CHAIN_ID=7810
EXPLORER_URL=

# Clé du déployeur — TEST UNIQUEMENT. Valeur par défaut = clé « ewoq » publique
# d'avalanche-cli, pré-financée sur la L1 locale. Jamais une clé réelle ici.
DEPLOYER_PRIVATE_KEY=0x56289e99c94b6912bfc12adc093c9b51124f0dc54ac7a766b2bc5ccf558d8027

# Persona « Auditeur » (clé auditeur eERC + IntentRegistry.setAuditor).
# Défaut = compte Anvil n°2 (mnémonique public de test), pré-financé sur la L1 locale.
AUDITOR_ADDRESS=0x3C44CdDdB6a900fa2b585dd299e03d12FA4293BC

# Adresses de contrats (remplies après `forge script` — voir docs/avalanche-l1.md).
# Vides pour un setup neuf : l'UI affiche « déploiement requis ».
NEXT_PUBLIC_INTENT_REGISTRY_ADDRESS=
NEXT_PUBLIC_MOCK_USDC_ADDRESS=
NEXT_PUBLIC_EERC_ADDRESS=
NEXT_PUBLIC_MOCK_USDT_ADDRESS=
NEXT_PUBLIC_ESCROW_FACTORY_ADDRESS=

# Ancien RPC Sepolia (escrow historique) — conservé tant que lib/escrow n'est pas migré.
SEPOLIA_RPC=https://ethereum-sepolia-rpc.publicnode.com

# --- Jev / Codiv (Système 1) -------------------------------------------------
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.codiv.ai
SYSTEM_ONE_MODEL=openjev-latest

# --- Mistral (Système 2) -----------------------------------------------------
MISTRAL_API_KEY=
